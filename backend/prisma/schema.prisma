generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique
  password         String
  createdAt        DateTime     @default(now())
  isVerified       Boolean      @default(false)
  otp              String?
  otpExpiry        DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  role             String       @default("manager")
  otpAttempts      Int          @default(0)
  otpBlockedUntil  DateTime?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  userStores       UserStore[]
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now())
  inventoryLedgers InventoryLedger[]
  predictions      Prediction[]
  products         Product[]
  sales            Sale[]
  stores           Store[]
  users            User[]
}

model Store {
  id               String            @id @default(uuid())
  name             String
  location         String?
  organizationId   String
  createdAt        DateTime          @default(now())
  inventory        Inventory[]
  inventoryLedgers InventoryLedger[]
  predictions      Prediction[]
  sales            Sale[]
  transfersFrom    StockTransfer[]   @relation("FromStore")
  transfersTo      StockTransfer[]   @relation("ToStore")
  organization     Organization      @relation(fields: [organizationId], references: [id])
  userStores       UserStore[]
}

model UserStore {
  id      String @id @default(uuid())
  userId  String
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, storeId])
}

model Product {
  id               String            @id @default(uuid())
  name             String
  sku              String
  category         String?
  price            Float
  cost             Float?
  organizationId   String
  createdAt        DateTime          @default(now())
  inventory        Inventory[]
  inventoryLedgers InventoryLedger[]
  predictions      Prediction[]
  organization     Organization      @relation(fields: [organizationId], references: [id])
  sales            Sale[]

  @@unique([organizationId, sku])
}

model Inventory {
  id                String   @id @default(uuid())
  storeId           String
  productId         String
  quantity          Int      @default(0)
  updatedAt         DateTime @updatedAt
  lowStockThreshold Int      @default(10)
  product           Product  @relation(fields: [productId], references: [id])
  store             Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, productId])
}

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  storeId        String
  productId      String
  quantity       Int
  priceAtSale    Float
  totalAmount    Float
  costAtSale     Float?
  profit         Float?
  soldAt         DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  store          Store        @relation(fields: [storeId], references: [id])

  @@index([organizationId])
  @@index([storeId])
  @@index([productId])
}

model InventoryLedger {
  id             String       @id @default(uuid())
  organizationId String
  storeId        String
  productId      String
  changeType     String
  quantityChange Int
  resultingQty   Int
  referenceId    String?
  createdBy      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  store          Store        @relation(fields: [storeId], references: [id])

  @@index([organizationId])
  @@index([storeId])
  @@index([productId])
}

model StockTransfer {
  id             String    @id @default(uuid())
  organizationId String
  fromStoreId    String
  toStoreId      String
  productId      String
  quantity       Int
  status         String    @default("pending")
  requestedAt    DateTime  @default(now())
  completedAt    DateTime?
  fromStore      Store     @relation("FromStore", fields: [fromStoreId], references: [id])
  toStore        Store     @relation("ToStore", fields: [toStoreId], references: [id])
}

model Prediction {
  id               String       @id @default(uuid())
  organizationId   String
  storeId          String
  productId        String
  predictedDemand  Int
  recommendedStock Int
  predictionDate   DateTime
  modelVersion     String
  confidenceScore  Float?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
  store            Store        @relation(fields: [storeId], references: [id])

  @@unique([storeId, productId, predictionDate])
}
